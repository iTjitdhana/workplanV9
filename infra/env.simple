# Example env file for Docker Compose in infra/
# Copy to .env and adjust values for your environment

# Frontend -> Backend URL exposed to browser (host port)
NEXT_PUBLIC_API_URL=http://localhost:3102

# Frontend -> Internal backend URL (service name in compose)
BACKEND_URL=http://backend:3101

# Database connection for backend
DB_HOST=localhost
DB_USER=workplan_user
DB_PASSWORD=change_me
DB_NAME=workplan
DB_PORT=3306

# CORS settings (comma-separated if multiple)
CORS_ORIGINS=http://localhost:3012

# Optional: backend port for docker-compose.linux.yml
PORT=3102

# Frontend menu external links (optional)
NEXT_PUBLIC_LOGS_URL=
NEXT_PUBLIC_SCHEDULE_URL=
